{
  "version": 2,
  "framework": "express",
  "functions": {
    "src/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/src/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/gift-sync-sheet",
      "schedule": "17 6 * * *"
    }
  ]
}
