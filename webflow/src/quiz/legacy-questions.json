 "image": {
  "id": "yearning.cluster_image",
  "type": "grid",
  "gridType": "grid-2x2",
  "prompt": "",
  "options": [
   {
    "value": "cluster_1",
    "label": "A place of belonging",
    "text": "You walk into the room. Faces turn, eyes soften, smiles spread wide — honest, true. A chair is pulled out for you. Hands reach, laughter opens. They are not smiling at the mask, not the act — they are smiling at you.",
    "imageId": "https://cdn.prod.website-files.com/68d100639551287fadcf87e3/69ac6eb567284d846e047521_q10a_01.jpg.jpg"
   },
   {
    "value": "cluster_2",
    "label": "A world of freedom",
    "text": "You stand on the mountain’s peak. The horizon stretches wide, unbroken. Cliffs. Rivers. A world. The wind rushes into your chest, sharp and alive. Behind you, the old weight has fallen. Before you, everything begins again — and all of it waits for you.",
    "imageId": "https://cdn.prod.website-files.com/68d100639551287fadcf87e3/69ac6eb6d46f27f86e902bb1_q10a_02.jpg.jpg"
   },
   {
    "value": "cluster_3",
    "label": "A moment of peace",
    "text": "You sit on a worn bench by the sea. The tide rolls in and out, the dark past soon forgotten. A soft breeze brushes your skin. The noise is gone — outside, inside. For the first time, you exhale, and the weight does not return.",
    "imageId": "https://cdn.prod.website-files.com/68d100639551287fadcf87e3/69ac6eb6ea33d4cf749a95a1_q10a_03.jpg.jpg"
   },
   {
    "value": "cluster_4",
    "label": "A legacy enduring",
    "text": "You place the torch in a child’s hands. Their eyes shine as they lift it high. “Thank you,” the girl says. The flame catches, and the night glows bright around you. It is not lost — it endures, carried forward, alive because of you.",
    "imageId": "https://cdn.prod.website-files.com/68d100639551287fadcf87e3/69ac6eb6a6bf20ffc4a8f593_q10a_04.jpg.jpg"
   }
  ]
 },
